# Copia este archivo como ".env" para correr en local.
# En Railway NO hace falta .env: define las variables en el servicio campcfcback.

# En Railway: DATABASE_URL = ${{Postgres.DATABASE_URL}}
# En local usa la DATABASE_PUBLIC_URL del servicio Postgres.
DATABASE_URL=postgresql://usuario:clave@host:5432/railway

# (Opcional) Si la defines, GET /api/evaluaciones y GET /api/inscripciones
# exigen el header  x-admin-key: <este valor>
ADMIN_KEY=

# Cupo total del campamento (opcional, por defecto 120)
CUPO_TOTAL=120

# Puerto (Railway lo asigna solo)
PORT=3000
